   "source": [
    "## CIR Model Calibration\n",
    "\n",
    "The Cox-Ingersoll-Ross (CIR) model extends the Vasicek framework by ensuring non-negative interest rates through a square-root diffusion process. Parameters are estimated using Maximum Likelihood Estimation."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 25,
   "id": "8231d25d-8cd9-4e7f-81ef-a8bd0b857d09",
   "metadata": {},
   "outputs": [],
   "source": [
    "def cir_neg_log_likelihood(params, r_t, r_next, dt): \n",
    "    a, b, σ = params\n",
    "    if a<=0 or b<=0 or σ<=0:\n",
    "       return 1e10\n",
    "    if  2*a*b <= σ**2:\n",
    "        return 1e10\n",
    "    c= (2 * a) / (σ**2 * (1 - np.exp(-a * dt)))\n",
    "    d= 4*a*b/(σ**2)\n",
    "    nc = 2 * c * r_t * np.exp(-a * dt)\n",
    "    y= 2*c*r_next\n",
    "    pdf= 2*c*ncx2.pdf(y, d, nc)\n",
    "    pdf= np.maximum(pdf, 1e-300)\n",
    "    return -np.sum(np.log(pdf)) \n",
    "       \n",
    "       "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 26,
   "id": "6d36810c-01ac-4a87-9bab-ec22ccad0e58",
   "metadata": {},
   "outputs": [],
   "source": [
    "initial_guess= [a_hat,b_hat, σ_hat]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 27,
   "id": "ddad775c-4f9a-4e52-8eb1-7dba7c4aea29",
   "metadata": {},
   "outputs": [],
   "source": [
    "bounds= [(1e-4, None), (1e-4, None), (1e-4, None)]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 28,
   "id": "78c2fdb9-9c38-4462-a144-11eb2966d458",
   "metadata": {},
   "outputs": [],
   "source": [
    "cir_result= minimize(cir_neg_log_likelihood, initial_guess, args=(r_t, r_next, dt), bounds=bounds, method= 'L-BFGS-B')"
   ]
  },
  {
