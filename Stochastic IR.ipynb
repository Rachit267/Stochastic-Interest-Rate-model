   "source": [
    "num_paths= 1000\n",
    "cir_paths= np.zeros((num_paths, N+1))\n",
    "for j in range(num_paths):\n",
    "    rt=r0\n",
    "    cir_paths[j,0] = rt\n",
    "    for i in range(N):\n",
    "          Z= np.random.normal()\n",
    "          rt= rt + a_cir*(b_cir -rt)*dt+ σ_cir*np.sqrt(max(rt,0))*np.sqrt(dt)*Z\n",
    "          rt = max(rt,0)\n",
    "          cir_paths[j, i+1] = rt\n"
   ]
