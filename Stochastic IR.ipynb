   "source": [
    "## Vasicek Model Calibration\n",
    "\n",
    "The Vasicek model assumes mean-reverting interest rates with normally distributed shocks. Parameters are estimated using Maximum Likelihood Estimation (MLE)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 41,
   "id": "8e0bfbd6-7e86-4cc7-8316-3e614820e1d7",
   "metadata": {},
   "outputs": [],
   "source": [
    "def neg_log_likelihood(params, r_t, dt, r_next):\n",
    "    a, b, σ = params\n",
    "    mean = r_t*np.exp(-a*dt) + b*(1- np.exp(-a*dt))\n",
    "    variance = (σ**2/(2*a))* (1-np.exp(-2*a*dt))\n",
    "    loglik = (-0.5*np.log(2*np.pi*variance)- ((r_next - mean)**2)/ (2*variance))\n",
    "    return -np.sum(loglik)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 42,
   "id": "17aa0975-f290-4573-96ad-eb76c9fdc4ca",
   "metadata": {},
   "outputs": [],
   "source": [
    "initial_guess= [ a0, b0, σ0]\n",
    "result = minimize(neg_log_likelihood, initial_guess, args=(r_t,dt,r_next), bounds=[(0.0001, None), (None, None), (0.0001, None)])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 43,
   "id": "c20690e6-0549-420a-9263-d19f9e1ca080",
   "metadata": {},
